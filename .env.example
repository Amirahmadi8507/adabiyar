NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-this-with-a-long-random-secret-before-sharing
# مسیر دیتابیس: بهتر است مسیر کامل و ثابت بدهید تا با عوض شدن پوشه‌ی پروژه گم نشود. مثال ویندوز: DB_FILE=C:/adabiyar-data/adabiyar.sqlite
DB_FILE=../data/adabiyar.sqlite
SITE_URL=http://localhost:3000
# پوشه‌ی دیتابیس و نشست‌ها (اختیاری). پیش‌فرض: پوشه‌ی data کنار پروژه
# DATA_DIR=../data
# پشت پروکسی معکوس (nginx/Caddy) مقدار 1 بگذارید تا IP و https درست تشخیص داده شود
# TRUST_PROXY=1
# کوکی فقط روی HTTPS؛ در production پیش‌فرض true است. اگر production را روی http محلی اجرا می‌کنید false بگذارید
# COOKIE_SECURE=false
# Initial administrator created only if no admin exists yet. Change these before first run.
ADMIN_EMAIL=admin@adabiyar.local
ADMIN_PASSWORD=ChangeMe-Now-9482
# Choose: ollama, openai, gemini, groq, openrouter, or off
# Ollama runs locally and does not require an API key. Install Ollama and pull the model first.
# ارائه‌دهنده‌ی هوش مصنوعی: gapgpt | openrouter | openai | gemini | groq | ollama | off
AI_PROVIDER=gapgpt

# GapGPT (سازگار با OpenAI). کلید را فقط در فایل .env خودتان بگذارید، نه در کد و نه در چت.
GAPGPT_API_KEY=
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_MODEL=claude-sonnet-5-5

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
# Configure only the provider you want to use; keys stay on the server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# کلید OpenRouter را فقط اینجا (در فایل .env خودتان) بگذارید، نه در کد
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_SITE_URL=http://localhost:3000
# پوشه‌ی دیتابیس و نشست‌ها (اختیاری). پیش‌فرض: پوشه‌ی data کنار پروژه
# DATA_DIR=../data
# پشت پروکسی معکوس (nginx/Caddy) مقدار 1 بگذارید تا IP و https درست تشخیص داده شود
# TRUST_PROXY=1
# کوکی فقط روی HTTPS؛ در production پیش‌فرض true است. اگر production را روی http محلی اجرا می‌کنید false بگذارید
# COOKIE_SECURE=false
OPENROUTER_APP_NAME=Adabiyar
